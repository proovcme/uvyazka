include plugin.json mcp.json server_entry.py
include AGENTS.md
include LICENSE NOTICE
include uv.lock
recursive-include desktop *.py *.rs *.toml *.lock *.json *.md *.html *.js *.css *.mjs *.ico
prune desktop/node_modules
prune desktop/ui-dist
prune desktop/src-tauri/target
prune desktop/src-tauri/binaries
prune desktop/src-tauri/gen
include tests/fixtures/structure-synthetic.xls tests/fixtures/structure-synthetic.md
include tests/fixtures/embedding_worker.py
recursive-include src/uvyazka/_vendor *.txt *.json
recursive-include tools *.py *.ps1 *.json *.mjs
recursive-include integrations *.rs *.toml *.lock *.md *.json *.csv
include integrations/cad-viewer/*.ts integrations/cad-viewer/*.mjs integrations/cad-viewer/*.html integrations/cad-viewer/*.css integrations/cad-viewer/LICENSE
prune integrations/cad-viewer/node_modules
prune integrations/cad-viewer/public
prune integrations/cad-viewer/dist
include integrations/rvt-rs/LICENSE integrations/rvt-rs/NOTICE
recursive-include integrations/browser-runtime *.txt
prune integrations/rvt-rs/target
prune integrations/rvt-metadata-reader/target
recursive-include skills *.md
recursive-include clients *.json *.toml
recursive-include docs *.md *.json
recursive-include docs/assets *.jpg *.svg *.png *.gif
recursive-include src/uvyazka/ui *.html *.js *.css
recursive-include src/uvyazka/resources *.json
recursive-include src/uvyazka/viewer *
prune src/uvyazka/viewer/updates
recursive-include web *.ts *.css *.html *.json *.mjs *.txt
prune web/node_modules
prune web/public/runtime
prune integrations/rvt-browser-bridge/target
prune web/test-results

include integrations/nwd-browser-bridge/NOTICE.txt integrations/nwd-browser-bridge/THIRD_PARTY_LICENSES.txt
prune integrations/nwd-browser-bridge/target

recursive-include web/assets *.ttf *.txt *.json
