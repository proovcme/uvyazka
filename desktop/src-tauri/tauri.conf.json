{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Увязка",
  "version": "0.4.0-alpha.4",
  "identifier": "work.locia.uvyazka",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Увязка — проекты и координация",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; frame-src http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost https://github.com https://api.github.com https://proovcme.github.io https://objects.githubusercontent.com https://release-assets.githubusercontent.com; img-src 'self' data:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/uvyazka-core"
    ],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQTFFMzk5NzdEMDZDQzkKUldUSmJOQjNtZU9ocjZtWVAxYmp6WDRKL21OSjN5WFIzTll4dUFnV3JXR3JtWnpmM0F1NEU4OUYK",
      "endpoints": [
        "https://proovcme.github.io/uvyazka/updates/beta.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
